datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  balance       Int      @default(0)
  bank          Int      @default(0)
  level         Int      @default(1)
  xp            Int      @default(0)
  createdAt     DateTime @default(now())

  clientSeed    String   @default("default-client-seed")
  serverSeed    String
  serverSeedHash String
  nonce         Int      @default(0)

  isBanned      Boolean  @default(false)
  nickname      String?
  rank          String   @default("newcomer")
  emailVerified    Boolean  @default(false)
  emailToken       String?
  emailTokenExpiry DateTime?

  patreonUsername  String?
  isApproved       Boolean   @default(false)
  approvedUntil    DateTime?
  patreonTier      String?
  isAdmin          Boolean   @default(false)

  flagged       Boolean  @default(false)
  flagReason    String?
  flaggedAt     DateTime?

  bets              Bet[]
  transactions      Transaction[]
  seedHistory       SeedRotation[]
  rakeback          RakebackClaim[]
  sentRequests      FriendRequest[] @relation("SentRequests")
  receivedRequests  FriendRequest[] @relation("ReceivedRequests")
  friendships       Friendship[]    @relation("UserFriends")
  friendOf          Friendship[]    @relation("FriendOf")
  nfts              Nft[]
  sentTrades        TradeOffer[]    @relation("SentTrades")
  receivedTrades    TradeOffer[]    @relation("ReceivedTrades")

  @@index([balance])
  @@index([level])
}

model SeedRotation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  serverSeed      String
  serverSeedHash  String
  clientSeed      String
  nonceCount      Int
  rotatedAt       DateTime @default(now())

  @@index([userId])
}

model Bet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  game        String
  amount      Int
  payout      Int
  multiplier  Float
  state       String
  result      String
  clientSeed  String
  serverSeed  String
  nonce       Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Int
  balance   Int
  reference String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RakebackClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  from      User     @relation("SentRequests", fields: [fromId], references: [id])
  to        User     @relation("ReceivedRequests", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([toId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserFriends", fields: [userId], references: [id])
  friend    User     @relation("FriendOf", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@index([userId])
}

model CrashRound {
  id           String   @id @default(cuid())
  roundNumber  Int      @unique
  serverSeed   String
  serverSeedHash String
  crashPoint   Float
  state        String
  startedAt    DateTime @default(now())
  endedAt      DateTime?
}

model HouseBank {
  id        String   @id
  chips     Int      @default(1000000000)
  dollars   Int      @default(1000000000)
  updatedAt DateTime @updatedAt
}

model HouseBankTransaction {
  id            String   @id @default(cuid())
  type          String
  chipsChange   Int      @default(0)
  dollarsChange Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
}

model Nft {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  description String
  rarity      String
  category    String
  emoji       String
  customImage String?
  mintedAt    DateTime @default(now())
  tradeItems  TradeOfferItem[]

  @@index([ownerId])
}

model TradeOffer {
  id              String   @id @default(cuid())
  fromId          String
  toId            String
  offeredChips    Int      @default(0)
  requestedChips  Int      @default(0)
  status          String   @default("pending")
  message         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  from            User     @relation("SentTrades", fields: [fromId], references: [id])
  to              User     @relation("ReceivedTrades", fields: [toId], references: [id])
  items           TradeOfferItem[]

  @@index([fromId])
  @@index([toId, status])
}

model TradeOfferItem {
  id           String     @id @default(cuid())
  tradeOfferId String
  nftId        String
  side         String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id])
  nft          Nft        @relation(fields: [nftId], references: [id])
}

model JackpotRound {
  id          String   @id @default(cuid())
  status      String   @default("open")
  totalPot    Int      @default(0)
  winnerId    String?
  winnerName  String?
  entries     String   @default("[]")
  createdAt   DateTime @default(now())
  closedAt    DateTime?
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NftSupply {
  templateId String @id
  minted     Int    @default(0)
}

model ActiveBuff {
  id        String    @id @default(cuid())
  userId    String
  type      String
  value     Float     @default(1.0)
  betsLeft  Int       @default(0)
  expiresAt DateTime?
  nftId     String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  chips       Int
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  @@unique([promoCodeId, userId])
}

model Broadcast {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CaseOpening {
  id         String   @id @default(cuid())
  userId     String
  caseId     String
  nftId      String
  rarity     String
  paidChips  Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

model AnticheatEvent {
  id          String    @id @default(cuid())
  userId      String
  reason      String
  details     String    @default("{}")
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([resolved])
}

model NftListing {
  id         String    @id @default(cuid())
  nftId      String    @unique
  sellerId   String
  priceChips Int
  status     String    @default("active")
  buyerId    String?
  createdAt  DateTime  @default(now())
  soldAt     DateTime?

  @@index([sellerId])
  @@index([status])
}

model Event {
  id           String   @id @default(cuid())
  hostId       String
  hostName     String
  title        String
  description  String   @default("")
  entryFee     Int      @default(0)
  maxPlayers   Int      @default(50)
  hostCutPct   Int      @default(5)
  prizePool    Int      @default(0)
  hostEarned   Int      @default(0)
  status       String   @default("open")
  winnerId     String?
  winnerName   String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  participants EventParticipant[]

  @@index([status])
  @@index([hostId])
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  username  String
  joinedAt  DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
}

model BoardGameRoom {
  id         String   @id @default(cuid())
  game       String
  status     String   @default("waiting")
  betChips   Int
  maxPlayers Int      @default(2)
  players    String   @default("[]")
  winnerId   String?
  state      String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([game, status])
}
