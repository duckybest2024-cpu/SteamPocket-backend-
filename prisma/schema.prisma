datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  balance       Int      @default(100000) // balance stored in cents (e.g. 100000 = $1,000.00 starting bonus)
  bank          Int      @default(0)      // "cashed out" chips stored here; players buy chips from bank to play
  level         Int      @default(1)
  xp            Int      @default(0)
  createdAt     DateTime @default(now())

  // Provably-fair seed pair currently active for this user
  clientSeed    String   @default("default-client-seed")
  serverSeed    String
  serverSeedHash String
  nonce         Int      @default(0)

  isBanned      Boolean  @default(false)
  nickname      String?
  rank          String   @default("newcomer")
  emailVerified    Boolean  @default(false)
  emailToken       String?
  emailTokenExpiry DateTime?

  // Patreon subscription system
  patreonUsername  String?
  isApproved       Boolean   @default(true)   // true for pre-existing accounts; false for new registrations
  approvedUntil    DateTime?
  patreonTier      String?                     // bronze_patron | silver_patron | gold_patron | platinum_patron | diamond_patron
  isAdmin          Boolean   @default(false)

  // Anti-cheat
  flagged       Boolean  @default(false)
  flagReason    String?
  flaggedAt     DateTime?

  bets              Bet[]
  transactions      Transaction[]
  seedHistory       SeedRotation[]
  rakeback          RakebackClaim[]
  sentRequests      FriendRequest[] @relation("SentRequests")
  receivedRequests  FriendRequest[] @relation("ReceivedRequests")
  friendships       Friendship[]    @relation("UserFriends")
  friendOf          Friendship[]    @relation("FriendOf")
  nfts              Nft[]
  sentTrades        TradeOffer[]    @relation("SentTrades")
  receivedTrades    TradeOffer[]    @relation("ReceivedTrades")

  @@index([balance])
  @@index([level])
}

model SeedRotation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  serverSeed      String   // revealed (previous) server seed
  serverSeedHash  String
  clientSeed      String
  nonceCount      Int
  rotatedAt       DateTime @default(now())

  @@index([userId])
}

model Bet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  game        String   // dice | crash | mines | limbo | roulette | blackjack | plinko | slots
  amount      Int      // wager, in cents
  payout      Int      // amount returned to user, in cents (0 = total loss)
  multiplier  Float    // resulting multiplier (payout / amount), 0 if lost
  state       String   // JSON blob describing the round (per-game shape)
  result      String   // "win" | "loss"
  clientSeed  String
  serverSeed  String   // revealed seed used for this bet (hashed seed was shown beforehand)
  nonce       Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // deposit | withdrawal | bet | payout | rakeback | bonus | levelup_bonus
  amount    Int      // signed delta, in cents
  balance   Int      // resulting balance after applying this transaction
  reference String?  // related bet id, claim id, etc.
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RakebackClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())
  from      User     @relation("SentRequests", fields: [fromId], references: [id])
  to        User     @relation("ReceivedRequests", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([toId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserFriends", fields: [userId], references: [id])
  friend    User     @relation("FriendOf", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@index([userId])
}

model CrashRound {
  id           String   @id @default(cuid())
  roundNumber  Int      @unique
  serverSeed   String
  serverSeedHash String
  crashPoint   Float
  state        String   // betting | running | crashed
  startedAt    DateTime @default(now())
  endedAt      DateTime?
}

model HouseBank {
  id        String   @id
  chips     Int      @default(1000000000)
  dollars   Int      @default(1000000000)
  updatedAt DateTime @updatedAt
}

model HouseBankTransaction {
  id            String   @id @default(cuid())
  type          String
  chipsChange   Int      @default(0)
  dollarsChange Int      @default(0)
  note          String?
  createdAt     DateTime @default(now())
}

model Nft {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  description String
  rarity      String   // common | uncommon | rare | epic | legendary
  category    String   // win | level | first | streak | special | custom
  emoji       String
  customImage String?  // base64 data URL for user-drawn NFTs
  mintedAt    DateTime @default(now())
  tradeItems  TradeOfferItem[]

  @@index([ownerId])
}

model TradeOffer {
  id              String   @id @default(cuid())
  fromId          String
  toId            String
  offeredChips    Int      @default(0)
  requestedChips  Int      @default(0)
  status          String   @default("pending") // pending | accepted | declined | cancelled
  message         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  from            User     @relation("SentTrades", fields: [fromId], references: [id])
  to              User     @relation("ReceivedTrades", fields: [toId], references: [id])
  items           TradeOfferItem[]

  @@index([fromId])
  @@index([toId, status])
}

model TradeOfferItem {
  id           String     @id @default(cuid())
  tradeOfferId String
  nftId        String
  side         String     // offered | requested
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id])
  nft          Nft        @relation(fields: [nftId], references: [id])
}

model JackpotRound {
  id          String   @id @default(cuid())
  status      String   @default("open")  // open | spinning | closed
  totalPot    Int      @default(0)
  winnerId    String?
  winnerName  String?
  entries     String   @default("[]") // JSON array of { userId, username, amount }
  createdAt   DateTime @default(now())
  closedAt    DateTime?
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NftSupply {
  templateId String @id
  minted     Int    @default(0)
}

model ActiveBuff {
  id        String    @id @default(cuid())
  userId    String
  type      String    // chips_bonus | xp_bonus | jackpot_entry | free_spin | multiplier_boost
  value     Float     @default(1.0)
  betsLeft  Int       @default(0)
  expiresAt DateTime?
  nftId     String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  chips       Int
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  @@unique([promoCodeId, userId])
}

model Broadcast {
  id        String   @id @default(cuid())
  message   String
  type      String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CaseOpening {
  id         String   @id @default(cuid())
  userId     String
  caseId     String
  nftId      String
  rarity     String
  paidChips  Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

model AnticheatEvent {
  id          String    @id @default(cuid())
  userId      String
  reason      String
  details     String    @default("{}")
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([resolved])
}

model NftListing {
  id         String    @id @default(cuid())
  nftId      String    @unique
  sellerId   String
  priceChips Int
  status     String    @default("active") // active | sold | cancelled
  buyerId    String?
  createdAt  DateTime  @default(now())
  soldAt     DateTime?

  @@index([sellerId])
  @@index([status])
}

model Event {
  id           String   @id @default(cuid())
  hostId       String
  hostName     String
  title        String
  description  String   @default("")
  entryFee     Int      @default(0)
  maxPlayers   Int      @default(50)
  hostCutPct   Int      @default(5)
  prizePool    Int      @default(0)
  hostEarned   Int      @default(0)
  status       String   @default("open")
  winnerId     String?
  winnerName   String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  participants EventParticipant[]

  @@index([status])
  @@index([hostId])
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  username  String
  joinedAt  DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
}

model BoardGameRoom {
  id         String   @id @default(cuid())
  game       String   // chess | checkers | battleship | durak | wildcards | poker | bridge | monopoly
  status     String   @default("waiting") // waiting | playing | finished
  betChips   Int
  maxPlayers Int      @default(2)
  players    String   @default("[]") // JSON array
  winnerId   String?
  state      String   @default("{}") // JSON game state
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([game, status])
}